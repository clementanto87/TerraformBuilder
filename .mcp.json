{
  "mcpServers": {
    "agent-vm": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/mcp/agent-vm/server.mjs"],
      "env": {
        "AGENT_VM_HOST": "${AGENT_VM_HOST:-49.13.196.104}",
        "AGENT_VM_USER": "${AGENT_VM_USER:-root}",
        "AGENT_VM_SSH_KEY": "${AGENT_VM_SSH_KEY:-~/.ssh/id_ed25519}",
        "AGENT_VM_PORT": "${AGENT_VM_PORT:-22}",
        "AGENT_VM_HOST_FINGERPRINT": "${AGENT_VM_HOST_FINGERPRINT:-}"
      }
    }
  }
}
