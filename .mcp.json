{
  "mcpServers": {
    "agent-vm": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/mcp/agent-vm/server.mjs"],
      "env": {
        "AGENT_VM_HOST": "${AGENT_VM_HOST:-52.143.63.207}",
        "AGENT_VM_USER": "${AGENT_VM_USER:-azureuser}",
        "AGENT_VM_SSH_KEY": "${AGENT_VM_SSH_KEY:-~/.ssh/agent-vm.pem}",
        "AGENT_VM_PORT": "${AGENT_VM_PORT:-22}",
        "AGENT_VM_HOST_FINGERPRINT": "${AGENT_VM_HOST_FINGERPRINT:-}"
      }
    }
  }
}
